{
  "name": "@remote-deck/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "test": "node --conditions=react-server --import tsx --import ./test/setup.mjs --test --test-isolation=none \"test/**/*.test.ts\"",
    "test:coverage": "node --conditions=react-server --experimental-test-coverage --test-coverage-include=lib/**/*.ts --test-coverage-include=components/terminalSizing.ts --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --import tsx --import ./test/setup.mjs --test --test-isolation=none \"test/**/*.test.ts\"",
    "lint": "eslint app.config.ts app components lib test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remote-deck/config": "workspace:*",
    "@expo/metro-runtime": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~19.1.0",
    "eslint": "9.39.2",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.17.11",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
